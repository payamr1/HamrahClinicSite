/**
 * همراه کلینیک — تنظیمات محلی
 *
 * این فایل را به config.php کپی کنید و مقادیر را پر کنید.
 * config.php در .gitignore است و هرگز در مخزن قرار نمی‌گیرد.
 *
 * محل درست فایل روی سرور:  ~/hamrah-app/config.php
 * یعنی بیرون از پوشه‌ی وب، تا از طریق مرورگر قابل خواندن نباشد.
 */

return [

    // ---- دیتابیس ------------------------------------------------
    // این مقادیر را از cPanel ▸ MySQL Databases بردارید.
    'db' => [
        'host'     => 'localhost',
        'name'     => 'CPANELUSER_hamrah',
        'user'     => 'CPANELUSER_hamrah',
        'pass'     => '',              // ← رمز دیتابیس را اینجا بگذارید
        'charset'  => 'utf8mb4',
    ],

    // ---- محیط ---------------------------------------------------
    // 'staging' روی new.hamrahclinic.ir  |  'production' روی دامنه‌ی اصلی
    'env' => 'staging',

    /*
     * دامنه‌ی canonical — مهم‌ترین تنظیم سئویی این فایل.
     *
     * تا وقتی روی new. کار می‌کنیم، تگ canonical و sitemap باید به
     * دامنه‌ی اصلی اشاره کنند تا نسخه‌ی آزمایشی با سایت اصلی رقابت نکند.
     * هنگام جایگزینی، این مقدار دست‌نخورده می‌ماند و env می‌شود production.
     */
    'canonical_host' => 'hamrahclinic.ir',

    /*
     * روی محیط staging کل سایت noindex می‌شود.
     * اگر این را false کنید و نسخه‌ی آزمایشی ایندکس شود،
     * محتوای تکراری می‌سازد و به رتبه‌ی سایت اصلی آسیب می‌زند.
     */
    'force_noindex' => true,

    // نمایش خطاها — روی production باید false باشد
    'debug' => true,

    /*
     * ---- پیامک (کاوه‌نگار) --------------------------------------
     *
     * ورود به پنل فقط با کد یک‌بارمصرف پیامکی است، پس بدون این
     * بخش هیچ‌کس نمی‌تواند وارد پنل شود.
     *
     * دو مقدار لازم است:
     *
     *   api_key — کاوه‌نگار ▸ حساب کاربری ▸ انتخاب وب سرویس
     *             یک رشته‌ی بلند، فقط حروف و رقم لاتین.
     *             ⚠ کپی‌اش کنید، دستی تایپش نکنید. یک حرف فارسی
     *             یا یک فاصله‌ی جاافتاده کافی است تا کاوه‌نگار
     *             «۴۰۰» خالی برگرداند بی‌آنکه بگوید چرا.
     *             _health.php?sms=1 کلید را می‌سنجد و نویسه‌ی
     *             نامعتبر را با جایگاهش نشان می‌دهد.
     *
     *   sender  — شماره‌ی خط خودتان در کاوه‌نگار، مثل 100020000
     *             دقیقاً همان‌طور که در پنل کاوه‌نگار نوشته شده،
     *             بدون فاصله و بدون صفر اضافه.
     *
     * ⚠ مهم: خط تبلیغاتی برای کد ورود مناسب نیست.
     *   خیلی از کاربران پیامک تبلیغاتی را روی خط خودشان بسته‌اند
     *   (لیست سیاه تبلیغاتی اپراتور) و در آن صورت کد هرگز نمی‌رسد.
     *   اگر خطتان خدماتی نیست، پیش از ساخت حساب یک بار امتحان
     *   کنید که پیامک به موبایل خودتان می‌رسد یا نه.
     */
    'sms' => [
        'api_key'  => '',      // ← کلید وب‌سرویس کاوه‌نگار
        'sender'   => '',      // ← شماره‌ی خط شما

        /*
         * متن پیامک. خالی بگذارید تا پیش‌فرض استفاده شود:
         *     کد ورود پنل همراه کلینیک: 123456
         *     تا ۳ دقیقه معتبر است.
         *
         * اگر خواستید عوضش کنید، {code} جای کد می‌نشیند.
         * حواستان به طول باشد: پیامک فارسی هر صفحه ۷۰ نویسه است و
         * یک نویسه بیشتر یعنی دو برابر هزینه. _health.php طول و
         * تعداد صفحه‌ی متن فعلی را نشان می‌دهد.
         */
        'message'  => '',

        /*
         * راه دوم، اگر روزی خواستید: الگوی وریفای کاوه‌نگار.
         * (کاوه‌نگار ▸ خدمات ▸ وریفای — الگویی با یک پارامتر %token)
         * اگر پر باشد، به‌جای sender از این استفاده می‌شود.
         */
        'template' => '',

        /*
         * راه اضطراری — پیش‌فرض خاموش، و باید خاموش بماند.
         *
         * اگر کاوه‌نگار از دسترس خارج شد یا اعتبار تمام شد، بدون
         * این گزینه هیچ‌کس نمی‌تواند وارد پنل شود. با true کردنش
         * کد به‌جای پیامک در لاگ خطای PHP نوشته می‌شود:
         *     ~/hamrah-app/logs/  یا  error_log کنار public_html
         *
         * هر کسی که به فایل‌های سرور دسترسی دارد کد را می‌بیند،
         * پس بلافاصله بعد از ورود دوباره false کنید.
         */
        'emergency_log_code' => false,
    ],

    // ---- پنل مدیریت ---------------------------------------------
    'admin' => [
        // مسیر ورود به پنل. عوض کردنش جلوی اسکن‌های خودکار را می‌گیرد.
        'path'            => '/admin',
        'session_name'    => 'hamrah_admin',
        'session_lifetime'=> 7200,     // ثانیه
    ],

    // کلید امضای CSRF و کوکی‌ها — یک رشته‌ی تصادفی بلند بگذارید.
    // تولید: php -r "echo bin2hex(random_bytes(32));"
    'app_key' => '',

    // ---- مسیرها -------------------------------------------------
    'paths' => [
        'uploads' => __DIR__ . '/../public_html/assets/uploads',
        'cache'   => __DIR__ . '/cache',
        'logs'    => __DIR__ . '/logs',
    ],
];
